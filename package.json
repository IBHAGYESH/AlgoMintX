{
  "name": "algomintx",
  "version": "2.0.6",
  "description": "White-label Algorand NFT/FT marketplace SDK for browser and Node.js",
  "main": "./dist/node/index.cjs",
  "browser": "./dist/algomintx.js",
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/algomintx.js",
        "require": "./dist/algomintx.js",
        "default": "./dist/algomintx.js"
      },
      "import": "./dist/node/index.cjs",
      "require": "./dist/node/index.cjs",
      "default": "./dist/algomintx.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "watch": "webpack --watch --config-name browser",
    "build": "webpack",
    "build:browser": "webpack --config-name browser",
    "build:node": "webpack --config-name node"
  },
  "keywords": [
    "algorand",
    "nft",
    "ft",
    "token",
    "marketplace",
    "asa",
    "algomintx",
    "plug-and-play",
    "white-label"
  ],
  "author": "Bhagyesh Jahangirpuria",
  "license": "ISC",
  "peerDependencies": {
    "algosdk": "^3.2.0"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.0.1",
    "@algorandfoundation/algorand-typescript": "^1.0.0-beta.69",
    "@blockshake/defly-connect": "^1.2.1",
    "@perawallet/connect": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.1",
    "@types/node": "^22.15.3",
    "algosdk": "^3.2.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
